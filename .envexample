# CHAT-API - Environment Configuration
# Copy this file to .env and fill in your values

# ===========================================
# LLM Provider Configuration
# ===========================================

# Provider: openai | anthropic
LLM_PROVIDER=openai

# OpenAI Configuration
OPENAI_API_KEY=sk-your-openai-api-key-here
OPENAI_MODEL=gpt-4o-mini

# Anthropic Configuration (if using anthropic provider)
ANTHROPIC_API_KEY=sk-ant-your-anthropic-api-key-here
ANTHROPIC_MODEL=claude-3-haiku-20240307

# ===========================================
# Generation Settings
# ===========================================

MAX_TOKENS=512
TEMPERATURE=0.7

# ===========================================
# Rate Limiting & Cost Protection
# ===========================================

# Maximum requests per window per IP
RATE_LIMIT_REQUESTS=20
RATE_LIMIT_WINDOW=60

# Cost protection limits
MAX_INPUT_LENGTH=500
MAX_MESSAGES_PER_SESSION=20
MAX_CONTEXT_MESSAGES=10

# ===========================================
# CORS Configuration
# ===========================================

# Comma-separated list of allowed origins (add your production domains)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ===========================================
# Custom System Prompts (Optional)
# ===========================================

# Option 1: Set prompts directly via environment variables
# SYSTEM_PROMPT_EN=You are a helpful assistant for MyCompany...
# SYSTEM_PROMPT_ZH=您是MyCompany的AI助手...

# Option 2: Load from a JSON file
# SYSTEM_PROMPT_FILE=/path/to/prompts.json
# File format: {"en": "...", "zh": "..."}

# If neither is set, generic default prompts are used

# ===========================================
# Application Settings
# ===========================================

# Environment: development | production
APP_ENV=development
LOG_LEVEL=INFO

# Server
HOST=0.0.0.0
PORT=8080

# ===========================================
# RAG System Configuration
# ===========================================

# Pinecone Vector Database (with integrated embeddings)
PINECONE_API_KEY=your-pinecone-api-key-here
PINECONE_INDEX=chat-api-rag-ahstudio

# Google Cloud Storage
GCS_BUCKET=chat-api-rag-documents
GCS_PREFIX=documents

# Document Processing
RAG_CHUNK_SIZE=512
RAG_CHUNK_OVERLAP=64
RAG_MAX_FILE_SIZE_MB=10

# RAG Query Settings
RAG_DEFAULT_TOP_K=5
RAG_MIN_SCORE_THRESHOLD=0.5
